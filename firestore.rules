rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }

    // Merchants multi-tenant profile
    match /merchants/{merchantId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(merchantId);
      allow delete: if false;

      // Products subcollection
      match /products/{productId} {
        allow read: if isSignedIn();
        allow write: if isOwner(merchantId);
      }

      // Invoices subcollection
      match /invoices/{invoiceId} {
        allow read: if isOwner(merchantId);
        allow create, update: if isOwner(merchantId);
        allow delete: if false;
      }
    }
  }
}
